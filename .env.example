# ============================================================
# FishEye 环境配置模板
#
# 用法：复制成 .env 再填值（.env 已被 .gitignore 排除，不会提交）
#   cp .env.example .env
#
# 三个密钥，只有第一个是必填：
#   1. AISSTREAM_API_KEY  —— 必需。AIS 实时数据源
#                            https://aisstream.io 注册后免费领取
#   2. CDSAPI_KEY         —— 可选。只影响 ERA5 历史风场回填
#                            https://cds.climate.copernicus.eu 注册 →
#                            个人页复制 API key，并到数据集页点「接受许可」
#   3. Copernicus Marine  —— 可选。只影响环境引擎（海温/海流/浪/叶绿素）
#                            不写在本文件，用命令行登录一次即可：
#                            python -m copernicusmarine login
#                            （免费注册 https://data.marine.copernicus.eu）
#
# 2 和 3 不配也能跑：环境引擎会在 /api/analysis/ocean/capabilities
# 里如实报 available=false 并说明原因，其它分析功能不受影响。
# ============================================================

# --- 数据源（必需）---
AISSTREAM_API_KEY=YOUR_AISSTREAM_KEY

# --- 数据库 / 存储 ---
FISHEYE_DB=./data/fisheye.db
FISHEYE_ARCHIVE_DIR=./data/archive
FISHEYE_ARCHIVE_ENABLED=1
FISHEYE_ARCHIVE_MAX_MB=2048

# --- 订阅范围（JSON，[lat_min, lon_min], [lat_max, lon_max]）---
# 全球范围吞吐极高（30+ 条/秒），首次验证建议先换成单个海域：
#   FISHEYE_BBOXES=[[[24,119],[33.5,128]]]
FISHEYE_BBOXES=[[[-90,-180],[90,180]]]

# --- 落库降采样：同一船 30s 或移动 100m 才写一条轨迹点（实时状态不受影响）---
FISHEYE_MIN_SAVE_INTERVAL=30
FISHEYE_MIN_SAVE_DISTANCE_M=100

# --- 分析范围 ---
# 生产环境建议改成重点海域，可显著降低 CPU 开销
# FISHEYE_ANALYTICS_BBOXES=[[[24,119],[33.5,128]],[[32,119],[41,127]]]
FISHEYE_ANALYTICS_WINDOW_HOURS=6
FISHEYE_ANALYTICS_MAX_VESSELS=1500

# --- 热数据保留天数 ---
FISHEYE_RETENTION_DAYS=30

# --- 智能体（可选，留空则退回内置规则解析，不依赖任何大模型）---
# 兼容任何 OpenAI 格式接口：DeepSeek / 通义 / 本地 vLLM 都行
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- ERA5 风场（可选）---
# 不配也能跑，默认风源是无需 key 的 NOAA GFS；ERA5 只用于更早的历史回填
CDSAPI_KEY=
